# Local development values only. Copy to .env, replace every value, never commit .env.
DB_HOST=db
DB_PORT=3306
DB_NAME=vijay_billing
# Read-only runtime account (see sql/least_privilege_user.sql). The compose file
# falls back to the starter's billing_app account if DB_USER is not set.
DB_USER=billing_app
DB_PASSWORD=local_only_password
MYSQL_ROOT_PASSWORD=local_only_root
API_ACCESS_TOKEN=local_testing_only_change_me
